<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Resolution_Notes_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Status__c,"Resolved"), ISBLANK(Resolution_Notes__c))</errorConditionFormula>
    <errorMessage>Resolution notes are required before marking an enquiry as Resolved.</errorMessage>
    <errorDisplayField>Resolution_Notes__c</errorDisplayField>
</ValidationRule>
