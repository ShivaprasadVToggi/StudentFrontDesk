# Salesforce connection — copy to .env and fill in (never commit .env)
# Used by scripts/deploy.sh and any local tooling.
SALESFORCE_CLIENT_ID=PlatformCLI
SALESFORCE_REDIRECT_URI=http://localhost:17171/OauthRedirect
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_INSTANCE_URL=https://your-org-name.develop.my.salesforce.com
SALESFORCE_USERNAME=your-username@agentforce.com
# Do NOT put tokens, passwords, or client secrets here in committed files.
# Access/refresh tokens are obtained via the OAuth flow and stored locally only.
